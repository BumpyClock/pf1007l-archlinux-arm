[Unit]
Description=PF1007L Wi-Fi control
After=systemd-modules-load.service
Wants=pf-wifi-dhcp.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/pf-wifi supplicant
Restart=on-failure
RestartSec=5
StateDirectory=pf-wifi
StateDirectoryMode=0700
RuntimeDirectory=pf-wifi
RuntimeDirectoryMode=0755
UMask=0077

[Install]
WantedBy=multi-user.target
