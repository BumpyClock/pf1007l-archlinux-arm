# Merged over U-Boot v2025.10's Sinlinx_SinA33_defconfig (A33, ZQ 15291, eMMC on MMC2 8-bit).
# DRAM clock from the PF1007L boot-access notes. See the local README for the qualified DRAM settings.
CONFIG_DRAM_CLK=456
# Pins for another board's panel and USB gadget: keep them off.
# CONFIG_VIDEO_SUNXI is not set
# CONFIG_VIDEO is not set
# CONFIG_CMD_DFU is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_USB_FUNCTION_MASS_STORAGE is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_ETHER is not set
# No networking at all (the USB Ethernet gadget pulled it in).
CONFIG_NO_NET=y
# CONFIG_NET is not set
# Never save an environment anywhere (no saveenv to the card or the eMMC).
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
CONFIG_CMD_FAT=y
CONFIG_FAT_WRITE=y
CONFIG_CMD_HASH=y
CONFIG_SHA256=y
CONFIG_CMD_SETEXPR=y
CONFIG_HUSH_PARSER=y
# Run only a33.scr from the card's FAT partition; no other boot sources.
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="fatload mmc 0:1 0x43100000 a33.scr && source 0x43100000"
